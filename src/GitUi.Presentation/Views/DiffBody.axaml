<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitUi.Presentation.Converters"
             xmlns:vm="clr-namespace:GitUi.Presentation.ViewModels"
             xmlns:svc="clr-namespace:GitUi.Application.Services;assembly=GitUi.Application"
             x:Class="GitUi.Presentation.Views.DiffBody"
             x:DataType="vm:DiffPresenter">
    <!-- Read-only diff of one file: unified or side by side (split), per the shared diff options. -->
    <UserControl.Styles>
        <Style Selector="ListBox.diff">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBlock.number">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <ListBox Classes="diff" ItemsSource="{Binding Rows}" IsVisible="{Binding !Settings.IsSplit}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DiffRow">
                    <Panel>
                        <Border IsVisible="{Binding IsHunkHeader}" Background="{DynamicResource PanelHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1" Padding="8,3">
                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Grid IsVisible="{Binding !IsHunkHeader}" ColumnDefinitions="48,48,18,*"
                              Background="{Binding Kind, Converter={x:Static conv:DiffLineKindToBrushConverter.Instance}}">
                            <TextBlock Grid.Column="0" Classes="number" Text="{Binding OldLineNumber}" />
                            <TextBlock Grid.Column="1" Classes="number" Text="{Binding NewLineNumber}" />
                            <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Kind, Converter={x:Static conv:DiffLineKindToPrefixConverter.Instance}}" />
                            <TextBlock Grid.Column="3" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,12,0"><Run Text="{Binding Prefix}" /><Run Text="{Binding Changed}" Background="{Binding Kind, Converter={x:Static conv:DiffLineKindToHighlightBrushConverter.Instance}}" /><Run Text="{Binding Suffix}" /></TextBlock>
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Classes="diff" ItemsSource="{Binding SplitRows}" IsVisible="{Binding Settings.IsSplit}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="svc:SideBySideRow">
                    <Panel>
                        <Border IsVisible="{Binding IsHunkHeader}" Background="{DynamicResource PanelHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1" Padding="8,3">
                            <TextBlock Text="{Binding Header}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Grid IsVisible="{Binding !IsHunkHeader}" ColumnDefinitions="44,*,1,44,*">
                            <Border Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="{Binding Left.Kind, Converter={x:Static conv:DiffLineKindToBrushConverter.Instance}, FallbackValue={x:Null}}" />
                            <TextBlock Grid.Column="0" Classes="number" Text="{Binding Left.LineNumber, FallbackValue=''}" />
                            <TextBlock Grid.Column="1" Text="{Binding Left.Text, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,8,0" />
                            <Border Grid.Column="2" Background="{DynamicResource PanelBorderBrush}" />
                            <Border Grid.Column="3" Grid.ColumnSpan="2"
                                    Background="{Binding Right.Kind, Converter={x:Static conv:DiffLineKindToBrushConverter.Instance}, FallbackValue={x:Null}}" />
                            <TextBlock Grid.Column="3" Classes="number" Text="{Binding Right.LineNumber, FallbackValue=''}" />
                            <TextBlock Grid.Column="4" Text="{Binding Right.Text, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,8,0" />
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Panel>
</UserControl>
