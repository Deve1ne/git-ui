<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitUi.Presentation.Views.InputDialog"
        Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Name="PromptText" TextWrapping="Wrap" />
        <TextBox Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" />
            <Button Name="OkButton" Content="OK" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
