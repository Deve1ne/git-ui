<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitUi.Presentation.Views.ConfirmationDialog"
        Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">
    <StackPanel Margin="18" Spacing="14">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" />
            <Button Name="ConfirmButton" Content="Confirm" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
